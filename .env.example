APP_NAME=Ashkan Industrial IoT Platform
ENVIRONMENT=development
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_ENABLED=true
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace-with-a-strong-token
INFLUXDB_ORG=industrial_io
INFLUXDB_BUCKET=sensor_data
CORS_ORIGINS=http://localhost:8000

# Change in production
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_HOURS=8
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_OPERATOR_PASSWORD=Operator@123
DEMO_VIEWER_PASSWORD=Viewer@123

POSTGRES_URL=postgresql://iiot:iiot-local-change-me@postgres:5432/iiot
REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
AUTH_SECRET=replace-with-a-long-random-secret
